# Copy to .env and fill in your OAuth client credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Set a fixed random string (in production, always set this or sessions reset on restart)
FLASK_SECRET_KEY=
# Production callback URL (must exactly match the "Authorized redirect URI" in Google Console)
# Leave empty for local dev; defaults to http://localhost:8008/callback
OAUTH_REDIRECT_URI=https://googleoauthgetbirthdaygender.vercel.app/auth/callback
